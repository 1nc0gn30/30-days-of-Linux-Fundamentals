---
import MainLayout from '../layouts/MainLayout.astro';
import { COURSE_WEEKS, DAY_METADATA, TOTAL_DAYS } from '../lib/course';

const totalWeeks = COURSE_WEEKS.length;
const totalStudyBlocks = TOTAL_DAYS * 3;
---

<MainLayout
  title="30 Days of Linux Fundamentals — ZothOS × 1nc0gn30 Interactive Linux Dojo"
  description="Master Linux from shell navigation to kernel modules, firewalls, and systemd in 30 digestible days through the native C TUI (./control-panel) and Web Mission Terminal."
  activeNav="home"
>
  <section class="section surface hero">
    <div class="hero-copy">
      <p class="eyebrow">⣿ ZOTHOS × 1NC0GN30 // SOVEREIGN LINUX DOJO v3.4</p>
      <h1>
        Master Linux from Kernel to Production in <span class="gold-text">30 Digestible Days.</span>
      </h1>
      <p class="muted lead">
        Built for rapid student comprehension and muscle memory. Every day is broken into three bite-sized sessions—<strong>🍳 Breakfast</strong> (Core Syntax), <strong>🥪 Lunch</strong> (Operational Flags), and <strong>🍽️ Dinner</strong> (Hardening &amp; Pipelines)—available in both the <strong>native C TUI (<code>./control-panel</code>)</strong> and this <strong>interactive Web Mission Terminal</strong>.
      </p>

      <div class="cli-bar" aria-label="Terminal quickstart command">
        <span class="cli-prompt">$</span>
        <code id="hero-cli-cmd">git clone https://github.com/1nc0gn30/30-days-of-Linux-Fundamentals.git &amp;&amp; cd 30-days-of-Linux-Fundamentals &amp;&amp; ./control-panel</code>
        <button type="button" class="cli-copy-btn" data-copy-hero-cli>Copy TUI</button>
      </div>

      <div class="hero-actions">
        <a class="btn btn-primary" href="/day/1">⚡ Start Day 01 Terminal</a>
        <a class="btn btn-emerald" href="/curriculum">🗺️ 30-Day Curriculum (90/90)</a>
        <a class="btn" href="#interactive-labs">🧪 Interactive Visual Labs</a>
        <a class="btn btn-resume" href="/curriculum" data-resume-link>▶ Resume Progress</a>
      </div>
      <p class="resume-note muted" data-resume-note>Progress-aware resume syncs automatically as you complete drills.</p>
    </div>

    <aside class="hero-visual-panel" aria-label="Interactive ZothOS x 1nc0gn30 Braille Kernel Visualizer">
      <div class="canvas-header">
        <span class="canvas-title">⣿ KERNEL LATTICE // 60FPS ASCII-BRAILLE</span>
        <div class="mode-pills" role="group" aria-label="Visualizer shader mode">
          <button type="button" class="mode-pill active" data-viz-mode="braille">⣿ Braille</button>
          <button type="button" class="mode-pill" data-viz-mode="dither">▦ Dither</button>
          <button type="button" class="mode-pill" data-viz-mode="fhs">/_ FHS</button>
          <button type="button" class="mode-pill" data-viz-mode="streams">◈ Streams</button>
        </div>
      </div>
      <pre class="braille-stage" id="linux-braille-stage" aria-hidden="true">Initializing ZothOS × 1nc0gn30 Kernel Lattice...</pre>
      <div class="hero-stats">
        <div class="stat-box">
          <span>Curriculum</span>
          <strong>{TOTAL_DAYS} Days · {totalWeeks} Weeks</strong>
        </div>
        <div class="stat-box">
          <span>Study Guides</span>
          <strong class="emerald-text">{totalStudyBlocks}/90 Complete</strong>
        </div>
        <div class="stat-box">
          <span>Native C TUI</span>
          <strong class="gold-text">./control-panel</strong>
        </div>
        <div class="stat-box">
          <span>Access Tier</span>
          <strong class="cyan-text">100% Free &amp; Open</strong>
        </div>
      </div>
    </aside>
  </section>

  <!-- DUAL-TRACK LEARNING ARCHITECTURE: TUI + WEB GUI -->
  <section class="section dual-track">
    <div class="section-head">
      <p class="eyebrow">DUAL-INTERFACE LEARNING ARCHITECTURE</p>
      <h2>Learn through the Terminal TUI and the Web GUI simultaneously</h2>
      <p class="muted">Whether you are inside a headless SSH session, a ZothOS Live ISO workstation, or your browser, every lesson and command drill stays in sync.</p>
    </div>

    <div class="dual-grid">
      <article class="surface track-card">
        <div class="track-badge gold-badge">TERMINAL INTERFACE (C BINARY)</div>
        <h3>1. Native C Dojo TUI (<code>./control-panel</code>)</h3>
        <p class="muted">Compiled zero-dependency C control deck with 90 interactive meal binaries (<code>breakfast-day-01</code>..<code>dinner-day-30</code>).</p>
        <pre class="mini-terminal"><code>╔══════════════════════════════════════════════════════════════╗
║ ⣿ ZOTHOS × 1NC0GN30 // 30 DAYS OF LINUX DOJO TUI v3.4       ║
╠══════════════════════════════════════════════════════════════╣
║ [1] 🗺️ 30-Day Curriculum Navigator (90 C Drills &amp; Guides)    ║
║ [2] ⚡ Direct Day Jump (Day 01–30)                           ║
║ [3] 📋 Master Linux Cheat-Sheet (--cheatsheet)               ║
║ [4] 🏛️ Visual Architecture Atlas (--atlas)                   ║
║ [5] 🎯 Rapid-Fire Flashcard Arena (XP &amp; Streak Tracker)      ║
║ [6] 🧪 Safe Practice Subshell (/tmp/linux-dojo-day-XX)       ║
╚══════════════════════════════════════════════════════════════╝</code></pre>
      </article>

      <article class="surface track-card">
        <div class="track-badge emerald-badge">BROWSER WORKSTATION (ASTRO UI)</div>
        <h3>2. Interactive Web Mission Terminal (<code>astro-ui</code>)</h3>
        <p class="muted">Practice typing exact command flags with real-time syntax verification, Command Intel cards, and visual architecture calculators.</p>
        <ul class="feature-checklist">
          <li><strong>🍳 Breakfast (Morning Syntax)</strong>: Build foundational muscle memory on 6–10 core commands with instant hints.</li>
          <li><strong>🥪 Lunch (Midday Workflows)</strong>: Combine flags, pipes, and process/disk/network diagnostics.</li>
          <li><strong>🍽️ Dinner (Evening Hardening)</strong>: Apply security permissions, firewall rules, systemd units, and shell automation.</li>
          <li><strong>📖 Built-In Visual Study Guides</strong>: Every session opens with a 60-Second Mental Model diagram and cheat-sheet table.</li>
        </ul>
      </article>
    </div>
  </section>

  <!-- INTERACTIVE VISUAL LINUX LABS -->
  <section class="section" id="interactive-labs">
    <div class="section-head">
      <p class="eyebrow">HANDS-ON VISUAL MENTAL MODELS</p>
      <h2>Interactive Linux Architecture Labs</h2>
      <p class="muted">Stop memorizing numbers blindly—interact with Linux permissions, the filesystem hierarchy, and stream pipelines right here.</p>
    </div>

    <div class="labs-grid">
      <!-- LAB 1: INTERACTIVE CHMOD CALCULATOR -->
      <article class="surface lab-card">
        <div class="lab-head">
          <div>
            <p class="eyebrow">VISUAL LAB 01 · PERMISSIONS</p>
            <h3>Interactive <code>chmod</code> Octal &amp; Bitwise Matrix</h3>
          </div>
          <div class="chmod-presets">
            <button type="button" class="preset-btn" data-chmod-preset="755">755 Script</button>
            <button type="button" class="preset-btn" data-chmod-preset="644">644 Config</button>
            <button type="button" class="preset-btn" data-chmod-preset="600">600 SSH Key</button>
            <button type="button" class="preset-btn" data-chmod-preset="750">750 Team</button>
          </div>
        </div>
        <p class="muted">Toggle Read (<code>4</code>), Write (<code>2</code>), and Execute (<code>1</code>) bits to see how octal numbers map to <code>ls -l</code> permission strings.</p>

        <div class="chmod-matrix">
          <div class="chmod-col">
            <h4>Owner (<code>u</code>)</h4>
            <label><input type="checkbox" data-bit="u-4" checked /> Read (r = 4)</label>
            <label><input type="checkbox" data-bit="u-2" checked /> Write (w = 2)</label>
            <label><input type="checkbox" data-bit="u-1" checked /> Execute (x = 1)</label>
          </div>
          <div class="chmod-col">
            <h4>Group (<code>g</code>)</h4>
            <label><input type="checkbox" data-bit="g-4" checked /> Read (r = 4)</label>
            <label><input type="checkbox" data-bit="g-2" /> Write (w = 2)</label>
            <label><input type="checkbox" data-bit="g-1" checked /> Execute (x = 1)</label>
          </div>
          <div class="chmod-col">
            <h4>Others (<code>o</code>)</h4>
            <label><input type="checkbox" data-bit="o-4" checked /> Read (r = 4)</label>
            <label><input type="checkbox" data-bit="o-2" /> Write (w = 2)</label>
            <label><input type="checkbox" data-bit="o-1" checked /> Execute (x = 1)</label>
          </div>
        </div>

        <div class="chmod-readout">
          <div class="readout-pill">
            <span>Octal Mode</span>
            <strong id="chmod-octal-out" class="gold-text">755</strong>
          </div>
          <div class="readout-pill">
            <span>Symbolic Mode</span>
            <strong id="chmod-sym-out" class="emerald-text">-rwxr-xr-x</strong>
          </div>
          <div class="readout-pill wide">
            <span>Terminal Command</span>
            <code id="chmod-cmd-out">chmod 755 deploy.sh &amp;&amp; ls -l deploy.sh</code>
          </div>
        </div>
        <p class="chmod-insight muted" id="chmod-insight-out">
          Standard mode for executable scripts and public directories: Owner has full control (7), Group and Others can read and execute (5).
        </p>
      </article>

      <!-- LAB 2: INTERACTIVE FHS EXPLORER -->
      <article class="surface lab-card">
        <div class="lab-head">
          <div>
            <p class="eyebrow">VISUAL LAB 02 · FILESYSTEM HIERARCHY (FHS)</p>
            <h3>Interactive Linux Root (<code>/</code>) Directory Explorer</h3>
          </div>
        </div>
        <p class="muted">Click any directory in the Linux Filesystem Hierarchy Standard to inspect what lives there and which commands query it.</p>

        <div class="fhs-buttons" role="tablist" aria-label="Linux root directories">
          <button type="button" class="fhs-btn active" data-fhs="/etc">/etc</button>
          <button type="button" class="fhs-btn" data-fhs="/var">/var</button>
          <button type="button" class="fhs-btn" data-fhs="/proc">/proc</button>
          <button type="button" class="fhs-btn" data-fhs="/bin">/bin</button>
          <button type="button" class="fhs-btn" data-fhs="/home">/home</button>
          <button type="button" class="fhs-btn" data-fhs="/dev">/dev</button>
          <button type="button" class="fhs-btn" data-fhs="/tmp">/tmp</button>
          <button type="button" class="fhs-btn" data-fhs="/usr">/usr</button>
        </div>

        <div class="fhs-detail-box">
          <div class="fhs-detail-top">
            <strong id="fhs-title" class="gold-text">/etc — Host-Specific System Configuration</strong>
            <span id="fhs-day-ref" class="fhs-badge">Days 01, 11, 12, 15, 21</span>
          </div>
          <p id="fhs-desc" class="muted">
            Contains static plain-text configuration files for the operating system and installed daemons. Zero binaries live here—only declarative configuration.
          </p>
          <div class="fhs-meta-grid">
            <div>
              <span class="meta-label">Critical Files Inside</span>
              <code id="fhs-files">/etc/passwd, /etc/fstab, /etc/ssh/sshd_config, /etc/sudoers</code>
            </div>
            <div>
              <span class="meta-label">Operator Inspection Command</span>
              <code id="fhs-cmd">ls -la /etc &amp;&amp; cat /etc/os-release</code>
            </div>
          </div>
        </div>
      </article>
    </div>

    <!-- LAB 3: PIPELINE & STANDARD STREAMS SIMULATOR -->
    <article class="surface lab-card pipeline-lab">
      <div class="lab-head">
        <div>
          <p class="eyebrow">VISUAL LAB 03 · UNIX PHILOSOPHY &amp; STREAMS</p>
          <h3>Interactive Linux Pipe (<code>|</code>) &amp; Log Triage Simulator</h3>
        </div>
        <div class="pipeline-steps" role="group" aria-label="Pipeline stage selector">
          <button type="button" class="pipe-btn active" data-pipe-stage="1">Stage 1: cat</button>
          <button type="button" class="pipe-btn" data-pipe-stage="2">Stage 2: | grep</button>
          <button type="button" class="pipe-btn" data-pipe-stage="3">Stage 3: | awk</button>
          <button type="button" class="pipe-btn" data-pipe-stage="4">Stage 4: | sort | uniq -c</button>
        </div>
      </div>
      <p class="muted">Click each stage to watch how raw security logs flow through <code>stdout (FD 1)</code> into <code>stdin (FD 0)</code> of the next tool to isolate an attacker IP.</p>
      <div class="pipeline-display">
        <div class="pipeline-cmd-bar">
          <span class="cli-prompt">pipeline$</span>
          <code id="pipe-cmd-text">cat /var/log/auth.log</code>
        </div>
        <pre class="pipeline-output" id="pipe-output-text">Nov 02 20:14:01 zoth-node sshd[4102]: Accepted publickey for zoth from 10.0.0.5 port 51204 ssh2
Nov 02 20:14:09 zoth-node sshd[4199]: Failed password for root from 198.51.100.42 port 39102 ssh2
Nov 02 20:14:11 zoth-node sshd[4201]: Failed password for root from 198.51.100.42 port 39108 ssh2
Nov 02 20:14:15 zoth-node sshd[4208]: Failed password for admin from 203.0.113.88 port 44120 ssh2
Nov 02 20:14:18 zoth-node sshd[4215]: Failed password for root from 198.51.100.42 port 39119 ssh2
Nov 02 20:14:22 zoth-node sudo[4250]:     zoth : TTY=pts/0 ; PWD=/home/zoth ; USER=root ; COMMAND=/usr/bin/ss -tulpen</pre>
      </div>
    </article>
  </section>

  <!-- 5-WEEK ROADMAP & 30-DAY QUICK MATRIX -->
  <section class="section week-breakdown">
    <div class="section-head">
      <p class="eyebrow">COMPLETE 5-WEEK CURRICULUM</p>
      <h2>Week-by-Week Sovereign Linux Roadmap</h2>
      <p class="muted">Click any day pill to jump directly into its interactive Mission Terminal and 3-meal study guides.</p>
    </div>

    <div class="week-grid">
      {COURSE_WEEKS.map((week) => {
        const weekDays = DAY_METADATA.filter((d) => d.weekId === week.id);
        return (
          <article class="surface week-card" style={`--week-accent: ${week.accent}`}>
            <div class="week-card-head">
              <p class="eyebrow" style={`color: ${week.accent}`}>Week {week.id} · Days {week.startDay}–{week.endDay}</p>
              <h3>{week.title}</h3>
              <p class="muted">{week.summary}</p>
            </div>
            <div class="week-day-pills">
              {weekDays.map((d) => (
                <a href={`/day/${d.day}`} class="day-jump-pill" title={`Day ${d.day}: ${d.title}`}>
                  <span class="day-num">D{String(d.day).padStart(2, '0')}</span>
                  <span class="day-short">{d.title}</span>
                </a>
              ))}
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="section surface cta-panel">
    <p class="eyebrow">100% OPEN-ACCESS • ZERO PAYWALLS</p>
    <h2>Ready to operate Linux with total confidence?</h2>
    <p class="muted">Open the Curriculum Control Center to track your 30-day completion bar, search by command, or jump straight into Day 1.</p>
    <div class="hero-actions" style="justify-content: center;">
      <a class="btn btn-primary" href="/day/1">⚡ Launch Day 01 Mission</a>
      <a class="btn btn-emerald" href="/curriculum">🗺️ Open Curriculum Control Center</a>
      <a class="btn" href="https://github.com/1nc0gn30/30-days-of-Linux-Fundamentals" target="_blank" rel="noopener noreferrer">★ Star on GitHub</a>
    </div>
  </section>
</MainLayout>

<script>
  const PROGRESS_KEY = 'linux30-course-progress-v1';

  function initHomePage() {
    // 1. Progress-aware resume
    const resumeLink = document.querySelector('[data-resume-link]');
    const resumeNote = document.querySelector('[data-resume-note]');
    if (resumeLink instanceof HTMLAnchorElement) {
      let progress = null;
      try {
        progress = JSON.parse(localStorage.getItem(PROGRESS_KEY) || 'null');
      } catch (_error) {
        progress = null;
      }
      const completed = Array.isArray(progress?.completedDays) ? progress.completedDays : [];
      const lastVisitedDay = Number(progress?.lastVisitedDay || 0);
      const nextTarget = Math.max(1, Math.min(30, completed.length > 0 ? Math.max(...completed) + 1 : lastVisitedDay || 1));
      resumeLink.href = `/day/${nextTarget}`;
      if (resumeNote instanceof HTMLElement) {
        resumeNote.textContent =
          completed.length === 0 && lastVisitedDay <= 1
            ? 'No saved progress yet — start with Day 01 Breakfast or run ./control-panel locally.'
            : `Resume target: Day ${String(nextTarget).padStart(2, '0')} · Completed days: ${completed.length}/30.`;
      }
    }

    // 2. Hero CLI copy button
    const copyCliBtn = document.querySelector('[data-copy-hero-cli]');
    const heroCliCmd = document.getElementById('hero-cli-cmd');
    if (copyCliBtn instanceof HTMLButtonElement && heroCliCmd && copyCliBtn.dataset.bound !== 'true') {
      copyCliBtn.dataset.bound = 'true';
      copyCliBtn.addEventListener('click', async () => {
        await navigator.clipboard.writeText(heroCliCmd.textContent || '');
        copyCliBtn.textContent = 'Copied!';
        setTimeout(() => {
          copyCliBtn.textContent = 'Copy TUI';
        }, 1400);
      });
    }

    // 3. Interactive Chmod Calculator
    const chmodCheckboxes = document.querySelectorAll<HTMLInputElement>('[data-bit]');
    const octalOut = document.getElementById('chmod-octal-out');
    const symOut = document.getElementById('chmod-sym-out');
    const cmdOut = document.getElementById('chmod-cmd-out');
    const insightOut = document.getElementById('chmod-insight-out');

    const updateChmod = () => {
      if (!octalOut || !symOut || !cmdOut || !insightOut) return;
      const roles = ['u', 'g', 'o'];
      let octal = '';
      let sym = '-';
      roles.forEach((r) => {
        const b4 = document.querySelector<HTMLInputElement>(`[data-bit="${r}-4"]`)?.checked ? 4 : 0;
        const b2 = document.querySelector<HTMLInputElement>(`[data-bit="${r}-2"]`)?.checked ? 2 : 0;
        const b1 = document.querySelector<HTMLInputElement>(`[data-bit="${r}-1"]`)?.checked ? 1 : 0;
        octal += String(b4 + b2 + b1);
        sym += (b4 ? 'r' : '-') + (b2 ? 'w' : '-') + (b1 ? 'x' : '-');
      });
      octalOut.textContent = octal;
      symOut.textContent = sym;
      cmdOut.textContent = `chmod ${octal} target.sh && ls -la target.sh`;
      const insights: Record<string, string> = {
        '755': 'Standard mode for executable scripts & public directories: Owner has full rwx (7), Group & Others have r-x (5).',
        '644': 'Standard mode for configuration files & docs: Owner can read/write (6), Group & Others can only read (4).',
        '600': 'Strict secret protection (required by OpenSSH for ~/.ssh/id_ed25519): Only Owner can read/write (6); zero access for others.',
        '750': 'Sovereign team workspace mode: Owner has full control (7), Group can read/traverse (5), World has zero access (0).',
        '777': '⚠️ Security Warning: World-writable & executable (777) allows any local user to modify and execute the file. Avoid in production!',
      };
      insightOut.textContent =
        insights[octal] ||
        `Custom permission mask ${octal} (${sym}): Owner=${octal[0]}, Group=${octal[1]}, Others=${octal[2]}.`;
    };

    chmodCheckboxes.forEach((cb) => {
      if (cb.dataset.bound !== 'true') {
        cb.dataset.bound = 'true';
        cb.addEventListener('change', updateChmod);
      }
    });

    document.querySelectorAll<HTMLButtonElement>('[data-chmod-preset]').forEach((btn) => {
      if (btn.dataset.bound === 'true') return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', () => {
        const preset = btn.dataset.chmodPreset || '755';
        const roles = ['u', 'g', 'o'];
        roles.forEach((r, idx) => {
          const digit = Number(preset[idx] || 0);
          const c4 = document.querySelector<HTMLInputElement>(`[data-bit="${r}-4"]`);
          const c2 = document.querySelector<HTMLInputElement>(`[data-bit="${r}-2"]`);
          const c1 = document.querySelector<HTMLInputElement>(`[data-bit="${r}-1"]`);
          if (c4) c4.checked = Boolean(digit & 4);
          if (c2) c2.checked = Boolean(digit & 2);
          if (c1) c1.checked = Boolean(digit & 1);
        });
        updateChmod();
      });
    });

    // 4. Interactive FHS Explorer
    const fhsData: Record<string, { title: string; days: string; desc: string; files: string; cmd: string }> = {
      '/etc': {
        title: '/etc — Host-Specific System Configuration',
        days: 'Days 01, 11, 12, 15, 21',
        desc: 'Contains static plain-text configuration files for the operating system, users, mounts, and daemons.',
        files: '/etc/passwd, /etc/fstab, /etc/ssh/sshd_config, /etc/sudoers',
        cmd: 'ls -la /etc && cat /etc/os-release',
      },
      '/var': {
        title: '/var — Variable Runtime Data & System Logs',
        days: 'Days 04, 13, 16, 18, 27',
        desc: 'Stores files that grow dynamically during system operation: system logs, package caches, cron spools, and web roots.',
        files: '/var/log/syslog, /var/log/auth.log, /var/log/journal/, /var/spool/cron',
        cmd: 'ls -lh /var/log && tail -n 25 /var/log/syslog',
      },
      '/proc': {
        title: '/proc — Virtual Kernel & Process Telemetry Filesystem',
        days: 'Days 02, 09, 14, 24, 26',
        desc: 'An in-memory pseudo-filesystem generated on the fly by the Linux kernel exposing live process states and hardware metrics.',
        files: '/proc/cpuinfo, /proc/meminfo, /proc/mounts, /proc/<PID>/fd',
        cmd: 'cat /proc/cpuinfo | head -n 20 && cat /proc/loadavg',
      },
      '/bin': {
        title: '/bin (/usr/bin) — Essential User Command Binaries',
        days: 'Days 01, 03, 08, 18',
        desc: 'Holds the core executable binaries required for single-user mode and daily shell operations.',
        files: '/bin/bash, /bin/ls, /bin/cp, /bin/mv, /bin/mkdir, /bin/grep',
        cmd: 'which bash ls grep && ls -lh /bin/bash',
      },
      '/home': {
        title: '/home — Operator Home Directories & Dotfiles',
        days: 'Days 01, 05, 20, 21',
        desc: 'Personal workspaces for non-root users, storing SSH keys, shell configurations (~/.bashrc), and project repositories.',
        files: '/home/zoth/.bashrc, /home/zoth/.profile, /home/zoth/.ssh/authorized_keys',
        cmd: 'cd ~ && ls -la && cat ~/.bashrc',
      },
      '/dev': {
        title: '/dev — Hardware & Virtual Device Nodes',
        days: 'Days 06, 12, 25',
        desc: 'Exposes block storage disks, character devices, pseudo-terminals, and special streams as files ("Everything is a file").',
        files: '/dev/sda, /dev/nvme0n1, /dev/null, /dev/zero, /dev/urandom',
        cmd: 'lsblk && ls -la /dev/null /dev/urandom',
      },
      '/tmp': {
        title: '/tmp — Volatile Scratch Workspace (1777 Sticky Bit)',
        days: 'Days 01, 05, 08, 19',
        desc: 'Temporary scratch storage writable by all users (protected by the sticky bit so users can only delete their own files).',
        files: '/tmp/linux-dojo-day-01, /tmp/systemd-private-*',
        cmd: 'mkdir -p /tmp/linux-dojo-day-01 && ls -ld /tmp',
      },
      '/usr': {
        title: '/usr — User System Resources, Libraries & Applications',
        days: 'Days 10, 14, 22',
        desc: 'Contains the majority of multi-user utilities, C header files, shared libraries (/usr/lib), and man pages (/usr/share/man).',
        files: '/usr/bin/env, /usr/sbin/iptables, /usr/local/bin/, /usr/share/man',
        cmd: 'du -sh /usr/* 2>/dev/null | sort -h',
      },
    };

    document.querySelectorAll<HTMLButtonElement>('[data-fhs]').forEach((btn) => {
      if (btn.dataset.bound === 'true') return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', () => {
        const key = btn.dataset.fhs || '/etc';
        const info = fhsData[key];
        if (!info) return;
        document.querySelectorAll('[data-fhs]').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        const t = document.getElementById('fhs-title');
        const d = document.getElementById('fhs-day-ref');
        const desc = document.getElementById('fhs-desc');
        const files = document.getElementById('fhs-files');
        const cmd = document.getElementById('fhs-cmd');
        if (t) t.textContent = info.title;
        if (d) d.textContent = info.days;
        if (desc) desc.textContent = info.desc;
        if (files) files.textContent = info.files;
        if (cmd) cmd.textContent = info.cmd;
      });
    });

    // 5. Interactive Pipeline Simulator
    const pipeStages: Record<string, { cmd: string; out: string }> = {
      '1': {
        cmd: 'cat /var/log/auth.log',
        out: `Nov 02 20:14:01 zoth-node sshd[4102]: Accepted publickey for zoth from 10.0.0.5 port 51204 ssh2
Nov 02 20:14:09 zoth-node sshd[4199]: Failed password for root from 198.51.100.42 port 39102 ssh2
Nov 02 20:14:11 zoth-node sshd[4201]: Failed password for root from 198.51.100.42 port 39108 ssh2
Nov 02 20:14:15 zoth-node sshd[4208]: Failed password for admin from 203.0.113.88 port 44120 ssh2
Nov 02 20:14:18 zoth-node sshd[4215]: Failed password for root from 198.51.100.42 port 39119 ssh2
Nov 02 20:14:22 zoth-node sudo[4250]:     zoth : TTY=pts/0 ; PWD=/home/zoth ; USER=root ; COMMAND=/usr/bin/ss -tulpen`,
      },
      '2': {
        cmd: 'cat /var/log/auth.log | grep "Failed password"',
        out: `Nov 02 20:14:09 zoth-node sshd[4199]: Failed password for root from 198.51.100.42 port 39102 ssh2
Nov 02 20:14:11 zoth-node sshd[4201]: Failed password for root from 198.51.100.42 port 39108 ssh2
Nov 02 20:14:15 zoth-node sshd[4208]: Failed password for admin from 203.0.113.88 port 44120 ssh2
Nov 02 20:14:18 zoth-node sshd[4215]: Failed password for root from 198.51.100.42 port 39119 ssh2`,
      },
      '3': {
        cmd: 'cat /var/log/auth.log | grep "Failed password" | awk \'{print $11}\'',
        out: `198.51.100.42
198.51.100.42
203.0.113.88
198.51.100.42`,
      },
      '4': {
        cmd: 'cat /var/log/auth.log | grep "Failed password" | awk \'{print $11}\' | sort | uniq -c | sort -nr',
        out: `      3 198.51.100.42   <-- [!] Brute-force source identified (ban via iptables / fail2ban)
      1 203.0.113.88`,
      },
    };

    document.querySelectorAll<HTMLButtonElement>('[data-pipe-stage]').forEach((btn) => {
      if (btn.dataset.bound === 'true') return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', () => {
        const st = btn.dataset.pipeStage || '1';
        const data = pipeStages[st];
        if (!data) return;
        document.querySelectorAll('[data-pipe-stage]').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        const cmdEl = document.getElementById('pipe-cmd-text');
        const outEl = document.getElementById('pipe-output-text');
        if (cmdEl) cmdEl.textContent = data.cmd;
        if (outEl) outEl.textContent = data.out;
      });
    });

    // 6. 60fps Unicode Braille / Bayer Dither Kernel Visualizer
    const stage = document.getElementById('linux-braille-stage');
    if (stage && stage.dataset.running !== 'true') {
      stage.dataset.running = 'true';
      let mode = 'braille';
      let tick = 0;

      document.querySelectorAll<HTMLButtonElement>('[data-viz-mode]').forEach((btn) => {
        btn.addEventListener('click', () => {
          mode = btn.dataset.vizMode || 'braille';
          document.querySelectorAll('[data-viz-mode]').forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
        });
      });

      const renderFrame = () => {
        tick += 0.08;
        const W = 44;
        const H = 13;
        const lines: string[] = [];

        if (mode === 'fhs') {
          const pulse = Math.floor(tick * 2) % 4;
          const marker = ['◈', '⣿', '▸', '⠿'][pulse];
          lines.push(`  ${marker} LINUX VFS INODE & DIRECTORY TREE (/)`);
          lines.push('  ┌── /bin   -> [ls, cp, mv, bash, grep, awk]');
          lines.push('  ├── /sbin  -> [iptables, fsck, sysctl, ip]');
          lines.push('  ├── /etc   -> [passwd, fstab, sshd_config]');
          lines.push('  ├── /proc  -> [cpuinfo, meminfo, /proc/PID]');
          lines.push('  ├── /var   -> [/var/log/syslog, journald]');
          lines.push('  ├── /home  -> [/home/zoth/.bashrc, .ssh/]');
          lines.push('  ├── /dev   -> [nvme0n1, null, zero, tty0]');
          lines.push('  └── /tmp   -> [drwxrwxrwt /tmp/linux-dojo]');
          lines.push('');
          lines.push('  SYSCALL: openat(AT_FDCWD, "/etc/passwd", O_RDONLY)');
          lines.push('  RING 0 : vfs_read() -> ext4_file_read_iter()');
          lines.push('  STATUS : [████████████████████] 90/90 GUIDES');
        } else if (mode === 'streams') {
          const p = Math.floor(tick * 3) % 12;
          const streamBar = Array.from({ length: 12 }, (_, i) => (i === p ? '██' : '══')).join('');
          lines.push('  ╔══ LINUX PROCESS DESCRIPTOR TABLE ════════╗');
          lines.push('  ║ FD 0 (stdin)  ──► [ keyboard / pipe ]    ║');
          lines.push('  ║ FD 1 (stdout) ──► [ terminal / > file ]  ║');
          lines.push('  ║ FD 2 (stderr) ──► [ 2>&1 / error.log ]   ║');
          lines.push('  ╚══════════════════════════════════════════╝');
          lines.push('');
          lines.push(`  [cat log] ${streamBar}► [grep ERR] ${streamBar}► [awk]`);
          lines.push('');
          lines.push('  OCTAL BITMASK : r(4) + w(2) + x(1) = 7');
          lines.push('  CHMOD 755     : -rwxr-xr-x (u=rwx,g=rx,o=rx)');
          lines.push('  CHMOD 600     : -rw------- (SSH key lock)');
          lines.push('  NETFILTER     : iptables -A INPUT -p tcp -j ACCEPT');
          lines.push('  SYSTEMD PID 1 : multi-user.target [ACTIVE]');
        } else {
          const brailleChars = ' ⠁⠃⠇⠏⠟⠿⣿';
          const ditherChars = ' ·░▒▓█';
          const palette = mode === 'braille' ? brailleChars : ditherChars;
          for (let y = 0; y < H; y++) {
            let row = '';
            const ny = (y - H / 2) / (H / 2);
            for (let x = 0; x < W; x++) {
              const nx = (x - W / 2) / (W / 2.4);
              const r = Math.sqrt(nx * nx + ny * ny);
              const angle = Math.atan2(ny, nx);
              const wave =
                Math.sin(r * 6.5 - tick * 1.8) * 0.5 +
                Math.cos(angle * 4 + tick) * 0.35 +
                Math.exp(-r * 2.2) * 0.7;
              const norm = Math.max(0, Math.min(0.999, (wave + 0.85) / 1.9));
              const idx = Math.floor(norm * palette.length);
              row += palette[idx];
            }
            lines.push(row);
          }
          lines[0] = ' ⣿ ZOTHOS × 1NC0GN30 // RING-0 KERNEL LATTICE ';
          lines[H - 1] = ` [TUI: ./control-panel]  [GUI: 30 DAYS / 90 LABS] `;
        }

        stage.textContent = lines.join('\n');
      };

      renderFrame();
      setInterval(renderFrame, 90);
    }
  }

  document.addEventListener('DOMContentLoaded', initHomePage);
  document.addEventListener('astro:page-load', initHomePage);
</script>

