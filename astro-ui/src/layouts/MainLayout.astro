---
interface Props {
  title: string;
  description?: string;
  activeNav?: 'home' | 'curriculum' | 'labs' | null;
}

const {
  title,
  description = 'Master Linux in 30 digestible days through the native C TUI (./control-panel) and interactive ZothOS × 1nc0gn30 Web Mission Terminal.',
  activeNav = null,
} = Astro.props;

import { ClientRouter } from 'astro:transitions';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const navItems = [
  { href: '/', label: 'Dojo Deck', id: 'home' },
  { href: '/#interactive-labs', label: 'Visual Labs & Atlas', id: 'labs' },
  { href: '/curriculum', label: '30-Day Curriculum', id: 'curriculum' },
  { href: '/day/1', label: 'Day 01 Terminal', id: null },
] as const;

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: '30 Days of Linux Fundamentals — ZothOS × 1nc0gn30 Edition',
      url: 'https://30-days-of-linux.netlify.app/',
      applicationCategory: 'EducationalApplication',
      operatingSystem: 'Linux, Web Browser',
      description:
        'Interactive 30-day Linux fundamentals curriculum featuring a native C TUI (./control-panel), 90 digestible study guides, visual FHS & chmod calculators, and live browser mission terminals.',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      creator: {
        '@type': 'Organization',
        name: '1nc0gn30',
        url: 'https://1nc0gn30.si',
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'How do I learn using both the TUI and the Web GUI?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Clone https://github.com/1nc0gn30/30-days-of-Linux-Fundamentals and run ./control-panel for the native C terminal TUI (with built-in Markdown reader, Flashcard Arena, and /tmp sandbox shells), or use the Astro Web GUI for browser command drills, XP tracking, and visual chmod/FHS calculators.',
          },
        },
        {
          '@type': 'Question',
          name: 'Is 30 Days of Linux Fundamentals completely free?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes, 100% of the 30 days, 90 study guides, C TUI drills, and web tools are open-source and unlocked by default with zero paywalls.',
          },
        },
      ],
    },
  ],
};
---

<html lang="en">
