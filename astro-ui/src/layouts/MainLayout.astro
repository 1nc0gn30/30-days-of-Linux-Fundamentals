        border-radius: 1rem;
        box-shadow: var(--shadow);
      }

      .eyebrow {
        margin: 0;
        color: var(--accent);
        font-family: var(--font-mono);
        font-size: 0.76rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-weight: 700;
      }

      .muted {
        color: var(--text-muted);
      }

      .footer {
        border-top: 1px solid var(--border);
        background: rgba(5, 7, 11, 0.92);
        padding: 1.8rem 1.2rem 2.4rem;
        color: var(--text-muted);
        font-size: 0.82rem;
      }

      .footer-inner {
        max-width: 1080px;
        margin: 0 auto;
        display: grid;
        gap: 1rem;
      }

      .footer-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.8rem;
      }

      .footer-links {
        display: flex;
        gap: 0.85rem;
        flex-wrap: wrap;
        font-family: var(--font-mono);
        font-size: 0.78rem;
      }

      .footer a {
        color: var(--accent);
        text-decoration: none;
      }

      .footer a:hover {
        text-decoration: underline;
      }

      .sol-tip-box {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        background: rgba(13, 17, 23, 0.95);
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        padding: 0.3rem 0.6rem;
        font-family: var(--font-mono);
        font-size: 0.72rem;
        color: var(--text-muted);
        max-width: 100%;
        flex-wrap: wrap;
      }

      .sol-copy-btn {
        appearance: none;
        background: rgba(245, 184, 46, 0.14);
        color: var(--accent);
        border: 1px solid var(--border-gold);
        border-radius: 0.35rem;
        padding: 0.18rem 0.48rem;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        cursor: pointer;
      }

      .mobile-drawer-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(3, 6, 12, 0.72);
        backdrop-filter: blur(4px);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s ease;
        z-index: 120;
      }

      .mobile-drawer {
        position: fixed;
        top: 0;
        right: 0;
        height: 100dvh;
        width: min(84vw, 320px);
        background: #0b0f17;
        border-left: 1px solid var(--border-gold);
        padding: 1rem;
        transform: translateX(104%);
        transition: transform 0.24s ease;
        z-index: 130;
        display: grid;
        grid-template-rows: auto 1fr;
        gap: 1rem;
      }

      .mobile-drawer.open {
        transform: translateX(0);
      }

      .mobile-drawer-backdrop.open {
        opacity: 1;
        pointer-events: auto;
      }

      .mobile-drawer-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .mobile-drawer-title {
        margin: 0;
        font-size: 1rem;
        font-family: var(--font-mono);
        color: var(--accent);
      }

      .mobile-drawer-links {
        display: grid;
        gap: 0.55rem;
        align-content: start;
      }

      .mobile-link {
        text-decoration: none;
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: 0.7rem;
        padding: 0.65rem 0.75rem;
        background: rgba(13, 17, 23, 0.9);
        font-family: var(--font-mono);
        font-size: 0.84rem;
      }

      .mobile-link:hover,
      .mobile-link.active {
        color: var(--accent);
        border-color: var(--accent);
      }

      @keyframes page-in {
        from {
          opacity: 0;
          transform: translateY(6px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @media (max-width: 860px) {
        .app-shell {
          border-inline: none;
        }
        .top-telemetry-ribbon {
          font-size: 0.68rem;
        }
        .ribbon-links {
          display: none;
        }
        .nav-links {
          display: none;
        }
        .nav-menu-btn {
          display: inline-flex;
        }
      }
    </style>
  </head>
  <body>
