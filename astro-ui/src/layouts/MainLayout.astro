    <style>
      :root {
        --bg: #05070b;
        --bg-soft: #0d1117;
        --card-bg: #101622;
        --card-glass: rgba(13, 17, 23, 0.88);
        --accent: #f5b82e;
        --accent-strong: #ffca4b;
        --accent-warm: #f5b82e;
        --emerald: #39d353;
        --cyan: #58a6ff;
        --purple: #d2a8ff;
        --coral: #ff7b72;
        --text: #f0f6fc;
        --text-muted: #8b949e;
        --border: #212836;
        --border-gold: rgba(245, 184, 46, 0.35);
        --shadow: 0 20px 55px rgb(0 0 0 / 0.45);
        --font-display: 'Syne', 'Space Grotesk', sans-serif;
        --font-sans: 'Space Grotesk', system-ui, sans-serif;
        --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        overflow-x: hidden;
      }

      body {
        background:
          radial-gradient(circle at 12% 0%, rgba(245, 184, 46, 0.11) 0%, transparent 34%),
          radial-gradient(circle at 88% 14%, rgba(57, 211, 83, 0.09) 0%, transparent 38%),
          radial-gradient(circle at 50% 90%, rgba(88, 166, 255, 0.08) 0%, transparent 40%),
          linear-gradient(180deg, #05070b 0%, #090d14 55%, #060910 100%);
        color: var(--text);
        font-family: var(--font-sans);
        line-height: 1.6;
        min-height: 100vh;
      }

      code,
      pre,
      .mono {
        font-family: var(--font-mono);
      }

      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: #05070b;
        color: var(--accent);
        border: 1px solid var(--accent);
        border-radius: 0.5rem;
        padding: 0.4rem 0.65rem;
        z-index: 200;
      }

      .skip-link:focus {
        left: 0.5rem;
        top: 0.5rem;
      }

      .top-telemetry-ribbon {
        background: rgba(5, 7, 11, 0.96);
        border-bottom: 1px solid rgba(245, 184, 46, 0.22);
        padding: 0.38rem clamp(0.75rem, 2.5vw, 1.8rem);
        font-family: var(--font-mono);
        font-size: 0.72rem;
        color: var(--text-muted);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
      }

      .ribbon-left {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        flex-wrap: wrap;
      }

      .ribbon-dot {
        width: 7px;
        height: 7px;
        border-radius: 999px;
        background: var(--emerald);
        box-shadow: 0 0 8px var(--emerald);
        display: inline-block;
      }

      .ribbon-pill {
        color: var(--accent);
        font-weight: 700;
      }

      .ribbon-links {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        flex-wrap: wrap;
      }

      .ribbon-links a {
        color: var(--text-muted);
        text-decoration: none;
        transition: color 0.18s ease;
      }

      .ribbon-links a:hover {
        color: var(--accent);
      }

      .app-shell {
        max-width: 1180px;
        margin: 0 auto;
        min-height: 100vh;
        border-inline: 1px solid rgba(245, 184, 46, 0.08);
        background: linear-gradient(180deg, rgba(8, 12, 20, 0.85), rgba(5, 7, 11, 0.75));
